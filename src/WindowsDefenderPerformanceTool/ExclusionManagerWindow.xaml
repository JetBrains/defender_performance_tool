<rxui:ReactiveWindow
    x:Class="WindowsDefenderPerformanceTool.ExclusionManagerWindow"
    x:TypeArguments="local:ExclusionManagerViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rxui="http://reactiveui.net"
    xmlns:local="clr-namespace:WindowsDefenderPerformanceTool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:ExclusionManagerViewModel, IsDesignTimeCreatable=True}"
    Title="Defender Exclusion Manager"
    Width="640" Height="480"
    WindowStartupLocation="CenterOwner">

    <DockPanel>
        <!-- Header: total + refresh -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,6">
                <Button DockPanel.Dock="Right"
                        AutomationProperties.AutomationId="RefreshButton"
                        Command="{Binding RefreshCommand}"
                        Padding="12,3"
                        VerticalAlignment="Center"
                        Content="Refresh"/>
                <TextBlock FontSize="13" VerticalAlignment="Center">
                    <Run Text="Total exclusions: " FontWeight="SemiBold"/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text="   ⚠ Every exclusion is a protection gap — use sparingly." Foreground="#A05000"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Footer: status message -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <TextBlock Margin="12,6"
                       AutomationProperties.AutomationId="StatusText"
                       Text="{Binding StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap"
                       FontSize="12">
                <TextBlock.Foreground>
                    <Binding Path="StatusIsError" Mode="OneWay">
                        <Binding.Converter>
                            <local:StatusBrushConverter/>
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Foreground>
            </TextBlock>
        </Border>

        <!-- Body: one tab per exclusion kind -->
        <TabControl AutomationProperties.AutomationId="ExclusionsTabControl" ItemsSource="{Binding Kinds}" Margin="4">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Title, Mode=OneWay}"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding Items.Count, Mode=OneWay, StringFormat='{}{0}'}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DockPanel Margin="8">
                        <!-- Hint above the input row -->
                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="{Binding Hint}"
                                   Foreground="Gray"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <!-- Add / remove row -->
                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.AutomationId="NewValueTextBox"
                                     Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Padding="4,2">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1"
                                    AutomationProperties.AutomationId="AddButton"
                                    Command="{Binding AddCommand}"
                                    Content="Add"
                                    Padding="16,4"
                                    Margin="8,0,0,0"/>
                            <Button Grid.Column="2"
                                    AutomationProperties.AutomationId="RemoveButton"
                                    Command="{Binding RemoveCommand}"
                                    CommandParameter="{Binding SelectedItem}"
                                    Content="Remove"
                                    Padding="16,4"
                                    Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Existing exclusions -->
                        <ListBox AutomationProperties.AutomationId="ExclusionsListBox"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Remove"
                                                          Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</rxui:ReactiveWindow>
